{{define "title"}}Doctor Dashboard - GoCare{{end}}

{{define "content"}}
<div class="dashboard-container">
    <header class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2>Doctor Dashboard</h2>
            <p style="color: #666;">Logged in as <strong>Dr. Sarah Connor</strong> (Doctor)</p>
        </div>
        <form action="/users/logout" method="POST" style="margin-left: auto;">
            <button type="submit" class="btn danger-btn" style="background-color: #dc3545; color: white; border: none; padding: 0.4rem 0.8rem; font-size: 0.9rem; border-radius: 4px; cursor: pointer; width: auto;">Log Out</button>
        </form>
    </header>

    <section class="create-appointment-section" style="background: #ffffff; padding: 1.5rem; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 2rem;">
        <h3 style="margin-top: 0; margin-bottom: 1rem;">Schedule New Appointment</h3>
        <form action="/appointments/create" method="POST" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">

            <div>
                <label for="patient_name" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Patient Name</label>
                <input type="text" id="patient_name" name="patient_name" placeholder="e.g., Jane Doe" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>

            <div>
                <label for="appointment_time" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Date & Time</label>
                <input type="datetime-local" id="appointment_time" name="appointment_time" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>

            <div>
                <label for="notes" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Notes</label>
                <input type="text" id="notes" name="notes" placeholder="e.g., Routine checkup" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>

            <div>
                <button type="submit" class="btn primary-btn" style="width: 100%; background-color: #0d6efd; color: white; border: none; padding: 0.55rem 1rem; font-weight: bold; border-radius: 4px; cursor: pointer;">Schedule Appointment</button>
            </div>

        </form>
    </section>

    <section class="appointments-list">
        <h3>System-Wide Appointments</h3>
        <table style="width: 100%; border-collapse: collapse; margin-top: 1rem; background: white; border: 1px solid #ddd;">
            <thead>
                <tr style="background-color: #f2f2f2; text-align: left;">
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">ID</th>
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">Patient Name</th>
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">Assigned Doctor</th>
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">Date & Time</th>
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">Status</th>
                    <th style="padding: 12px; border-bottom: 1px solid #ddd;">Notes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">#101</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Lalatina Dustiness</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Dr. Sarah Connor</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Aug 25, 2026 - 10:00 AM</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;"><span style="color: green; font-weight: bold;">Confirmed</span></td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Routine annual physical exam</td>
                </tr>
                <tr>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">#102</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">John Doe</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Dr. Soylita</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Aug 26, 2026 - 02:30 PM</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;"><span style="color: orange; font-weight: bold;">Pending</span></td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Follow-up consultation</td>
                </tr>
                <tr>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">#103</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Bruce Wayne</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Dr. Sarah Connor</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Aug 27, 2026 - 11:15 AM</td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;"><span style="color: green; font-weight: bold;">Confirmed</span></td>
                    <td style="padding: 12px; border-bottom: 1px solid #ddd;">Joint and muscle checkup</td>
                </tr>
            </tbody>
        </table>
    </section>
</div>
{{end}}