{{define "title"}}Welcome - GoCare{{end}}

{{define "content"}}
<div class="auth-grid">
    <!-- Left Column: Hero/Info -->
    <div class="hero-card">
        <h2>Healthcare simplified for patients and doctors.</h2>
        <p>Book appointments, manage schedule availability, and access patient medical records securely from any device.</p>
        <ul class="feature-list">
            <li><strong>Patients:</strong> Find specialized doctors and schedule visits.</li>
            <li><strong>Doctors:</strong> Access patient histories and record treatment notes.</li>
            <li><strong>Secure:</strong> Encrypted records and role-based access control.</li>
        </ul>
    </div>

    <!-- Right Column: Login / Register Box -->
    <div class="auth-card">
        
        <!-- Auth Tabs: Dynamically add 'active' based on FormName -->
        <div class="tab-header">
            <button class="tab-btn {{if ne .Validator.FormName "register"}}active{{end}}" onclick="switchTab('login')">Log In</button>
            <button class="tab-btn {{if eq .Validator.FormName "register"}}active{{end}}" onclick="switchTab('register')">Register</button>
        </div>

        <!-- Login Form -->
        <form id="login-form" action="/users/login" method="POST" class="auth-form {{if ne .Validator.FormName "register"}}active{{end}}">
            <h3>Account Login</h3>
            
            <div class="form-group">
                <label for="login-email">Email Address</label>
                <input type="email" id="login-email" name="email" value="{{.User.Email}}" required placeholder="doctor@gocare.org">
                {{with .Validator.Errors.email}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <div class="form-group">
                <label for="login-password">Password</label>
                <input type="password" id="login-password" name="password" required placeholder="••••••••">
                {{with .Validator.Errors.password}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <button type="submit" class="btn primary-btn">Sign In</button>
        </form>

        <!-- Registration Form -->
        <form id="register-form" action="/users/register" method="POST" class="auth-form {{if eq .Validator.FormName "register"}}active{{end}}">
            <h3>Create Account</h3>
            
            <!-- Full Name -->
            <div class="form-group">
                <label for="reg-name">Full Name</label>
                <input type="text" id="reg-name" name="name" value="{{.User.Name}}" required placeholder="Dr. Sarah Connor or John Doe">
                {{with .Validator.Errors.name}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <!-- Email -->
            <div class="form-group">
                <label for="reg-email">Email Address</label>
                <input type="email" id="reg-email" name="email" value="{{.User.Email}}" required placeholder="your.email@example.com">
                {{with .Validator.Errors.email}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <!-- Role -->
            <div class="form-group">
                <label for="reg-role">I am a:</label>
                <select id="reg-role" name="role" required>
                    <option value="patient" {{if eq .User.Role "patient"}}selected{{end}}>Patient</option>
                    <option value="doctor" {{if eq .User.Role "doctor"}}selected{{end}}>Doctor</option>
                </select>
                {{with .Validator.Errors.role}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <!-- Password -->
            <div class="form-group">
                <label for="reg-password">Password</label>
                <input type="password" id="reg-password" name="password" required placeholder="••••••••">
                {{with .Validator.Errors.password}}
                    <p style="color: red; margin-top: 4px;">{{.}}</p>
                {{end}}
            </div>
            
            <button type="submit" class="btn primary-btn">Register</button>
        </form>

    </div>
</div>
{{end}}